# Backend environment example — copy to .env and fill in real values
NODE_ENV=development
PORT=5087

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=thegoldenolive

# Use a long random string (>= 32 chars). Never commit real secrets.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5087

# Multi-tenant: public storefront company (The Golden Olive)
PUBLIC_COMPANY_ID=1

# Optional Redis for BullMQ print dispatch (falls back to MySQL poller if unset)
REDIS_URL=

# AES-GCM key for encrypting per-tenant secrets in company_settings (32+ chars)
SETTINGS_ENCRYPTION_KEY=

# Mollie
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=http://localhost:5087/api/payments/webhook

# Billing portal stub (optional)
BILLING_PORTAL_URL=
STRIPE_SECRET_KEY=

# Admin seed (used by npm run seed)
ADMIN_EMAIL=admin@thegoldenolive.be
ADMIN_PASSWORD=change-me-strong-password

# Dev only: allow platform webhooks without signature secret
# NEVER enable in production
ALLOW_INSECURE_WEBHOOKS=false

# Optional Sentry (no-op wrapper if unset)
SENTRY_DSN=

LOG_LEVEL=info
